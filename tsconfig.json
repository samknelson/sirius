{
  "include": ["client/src/**/*", "shared/**/*", "server/**/*", "tests/**/*", "components/**/*"],
  // Historical scripts explicitly relocated into legacy-oneoffs retain their
  // original checking scope; maintained component scripts remain checked.
  "exclude": [
    "node_modules", "build", "dist",
    "components/*/scripts/legacy-oneoffs/**/*"
  ],
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./.cache/typescript/tsbuildinfo",
    "noEmit": true,
    "target": "ES2020",
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
